# MQTT connection for mi2mqtt. Copy to .env (never committed) and fill in:
#   cp .env.example .env && chmod 600 .env
# mi2mqtt reads .env from the current directory (or --env-file PATH). Variables that are
# already set in the environment take precedence. Same format as a systemd EnvironmentFile,
# so on the server this file can be /etc/mi2mqtt/env.

MI_MQTT_HOST=127.0.0.1
MI_MQTT_PORT=1883
MI_MQTT_USERNAME=
MI_MQTT_PASSWORD=

# Any other mqtt: setting works the same way, e.g.:
# MI_MQTT_PREFIX=mi
# MI_MQTT_CLIENT_ID=mi2mqtt
