# Example unit: adapt it to your system before installing it (see README, "Installation"):
# - User/Group: the account that runs mi2mqtt and can read the install directory, including .env
# - WorkingDirectory/ExecStart: where you cloned mi2mqtt; mi2mqtt.yaml and .env are read from there
# - ProtectHome=true hides /home: use ProtectHome=read-only when installed under a home directory
[Unit]
Description=mi2mqtt: Xiaomi BLE thermometers to MQTT
Wants=network-online.target bluetooth.service
After=network-online.target bluetooth.service

[Service]
Type=simple
User=wim
Group=wim
# D-Bus access to BlueZ (org.bluez) is granted to the bluetooth group
SupplementaryGroups=bluetooth
WorkingDirectory=/srv/scripts/mi2mqtt
ExecStart=/srv/scripts/mi2mqtt/.venv/bin/mi2mqtt
Restart=on-failure
RestartSec=10

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
